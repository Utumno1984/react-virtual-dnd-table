{
  "name": "react-virtual-dnd-table",
  "version": "0.1.1",
  "description": "Drag-to-reorder for virtualized row lists (TanStack Virtual, react-window, ...) where dnd-kit alone can't see off-screen rows.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "drag-and-drop",
    "dnd-kit",
    "virtualization",
    "tanstack-virtual",
    "tanstack-table",
    "react-window",
    "row-reorder"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Utumno1984/react-virtual-dnd-table.git",
    "directory": "packages/react-virtual-dnd-table"
  },
  "homepage": "https://github.com/Utumno1984/react-virtual-dnd-table#readme",
  "bugs": {
    "url": "https://github.com/Utumno1984/react-virtual-dnd-table/issues"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "~6.0.2"
  }
}
